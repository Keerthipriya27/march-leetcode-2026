class Solution:
    def numberOfSubmatrices(self, grid: List[List[str]]) -> int:
        m, n = len(grid), len(grid[0])
        
        x_count = [[0]*(n+1) for _ in range(m+1)]
        y_count = [[0]*(n+1) for _ in range(m+1)]

        for i in range(m):
            for j in range(n):
                x_count[i+1][j+1] = x_count[i][j+1] + x_count[i+1][j] - x_count[i][j]
                y_count[i+1][j+1] = y_count[i][j+1] + y_count[i+1][j] - y_count[i][j]
                
                if grid[i][j] == 'X':
                    x_count[i+1][j+1] += 1
                elif grid[i][j] == 'Y':
                    y_count[i+1][j+1] += 1
        
        res = 0

        for i in range(m):
            for j in range(n):
                x = x_count[i+1][j+1]
                y = y_count[i+1][j+1]
                
                if x == y and x > 0:
                    res += 1
        
        return res
